{
 "id": "settlements",
 "category": "legal",
 "name_ar": "التسويات والتنازلات والصلح",
 "summary_ar": "قسم داخل صفحة القضية لتسجيل تسوية أو تنازل أو صلح: نوعه، ومن قدّم العرض، وقيمة التسوية، والمبررات القانونية والأثر المالي والرأي القانوني وجهة الموافقة، مع ربط مستندات مؤيدة من ملف القضية، وانتقال بين حالات (مقترحة، قيد المراجعة، معتمدة، مرفوضة، منفذة، مسحوبة) وسجل كامل لكل تغيير.",
 "purpose_ar": "توثيق ما يُعرض على الجهة من تسويات وما قُرِّر بشأنه ومن قرّر ومتى ولماذا، دون أن يغيّر ذلك حالة القضية: إنهاء القضية يبقى قرارًا يدويًا يتخذه العضو المختص.",
 "who_ar": [
  "مدير الشؤون القانونية",
  "رئيس القسم",
  "الموظف القانوني (التسجيل والتعديل)",
  "مدير النظام",
  "من يرى القضية (للاطلاع فقط)"
 ],
 "who_perms": [
