{
 "id": "legal-docs",
 "category": "documents",
 "name_ar": "المذكرات والمراسلات ودورة اعتمادها",
 "summary_ar": "سجل المذكرات والكتب الخاصة بكل قضية. تمر المذكرة أو الكتاب بالحالات: مسودة، قيد المراجعة، معتمد، مرسل (مسجَّل)، محفوظ. يرفق العضو نسخة إلكترونية، ويعتمدها من يملك صلاحية الاعتماد، ويسجّل العضو أنه أرسلها؛ النظام لا يرسل شيئًا بنفسه.",
 "purpose_ar": "ضبط دورة المذكرات والمراسلات القانونية بفصل الإعداد عن الاعتماد، وحفظ النسخة الإلكترونية المعتمدة دون تغيير، وتسجيل تاريخ الإرسال وطريقته.",
 "who_ar": [
  "من يملك عرض المستندات (DOCUMENT_VIEW) للاطلاع",
  "من يملك إدارة المستندات (DOCUMENT_MANAGE) للتسجيل والتعديل والإرسال للمراجعة وتسجيل الإرسال والحفظ",
  "من يملك اعتماد المذكرات والمراسلات (MEMO_APPROVE): مسؤول النظام والمدير القانوني ورئيس القسم"
 ],
 "who_perms": [
  "DOCUMENT_VIEW",
  "DOCUMENT_MANAGE",
  "MEMO_APPROVE"
 ],
 "access_ar": "صفحة القضية > قسم «المذكرات والمراسلات»",
 "route": "/cases/:id (قسم المذكرات والمراسلات)",
 "prerequisites_ar": [
  "قضية مرئية وغير مؤرشفة",
  "لتسجيل أو تعديل: حق تعديل القضية",
  "للاعتماد: حق رؤية القضية فقط مع MEMO_APPROVE (ليس بالضرورة حق التعديل)"
 ],
