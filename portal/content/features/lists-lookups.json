{
  "id": "lists-lookups",
  "category": "cases",
  "name_ar": "القوائم المعيارية (القوائم المرجعية)",
  "summary_ar": "قوائم مرجعية مضبوطة تُستعمل في أماكن الاختيار بدل الكتابة الحرة، وهي نوعان في النظام: قوائم تدير شاشتها «القوائم المعيارية» (أنواع الأحكام وصفات الأحكام، ولها كذلك قائمة تصنيفات المستندات في الخادم)، وقوائم الأنواع (أنواع التسويات وأنواع التكليفات وأنواع النماذج القانونية) التي تُقرأ في الشاشات وتُدار عبر واجهة البرمجة. لا تُحذف قيمة أبدًا؛ تُعطَّل فقط وتبقى للسجلات القديمة.",
  "purpose_ar": "توحيد المصطلحات، ومنع اختلاف كتابة النوع الواحد، والتمييز بين ما ورد في وثيقة المتطلبات وما اقترحه المنفذون وينتظر الاعتماد، مع حفظ سجل لكل تغيير.",
  "who_ar": [
    "من يملك «عرض القضايا» لقراءة القوائم",
    "من يملك «إدارة القوائم المعيارية» لإضافة قيم أنواع الأحكام وصفاتها وتصنيفات المستندات واعتمادها وتعطيلها",
    "من يملك «إدارة التسويات» أو «إدارة التكليفات» أو «إدارة النماذج القانونية» لإدارة القائمة الخاصة بمجاله"
  ],
  "who_perms": [
    "CASE_VIEW",
    "LOOKUP_MANAGE",
    "SETTLEMENT_MANAGE",
    "DIRECTIVE_MANAGE",
    "TEMPLATE_MANAGE"
  ],
  "access_ar": "الإدارة > القوائم المعيارية",
  "route": "/admin/lookups",
  "prerequisites_ar": [
    "تسجيل الدخول وامتلاك LOOKUP_MANAGE لرؤية تبويب «القوائم المعيارية» في الإدارة.",
    "أما قوائم الأنواع (التسويات والتكليفات والنماذج) فلا توجد في الواجهة شاشة لإضافة قيمها؛ تُقرأ في شاشاتها وتُدار بواجهة البرمجة فقط."
