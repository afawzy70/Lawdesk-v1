{
 "id": "library",
 "category": "legal",
 "name_ar": "مكتبة الأحكام والسوابق القضائية",
 "summary_ar": "مرجع مشترك للإدارة تحفظ فيه الأحكام المهمة وسوابقها: يسجّل العضو الحكم بمحكمته ورقمه وموضوعه ومصدره وطريقة التحقق منه، ويبحث الجميع بالعربية في نصه ومبادئه، ويمكن حفظ نسخة إلكترونية منه، وسحب الحكم من الاستعمال دون حذفه، وربط حكم بقضية مع بيان سبب الاستفادة منه.",
 "purpose_ar": "ألا تضيع الأحكام المفيدة بين الملفات: تبقى مكتبة موحدة يمكن البحث فيها وتتبع مصدرها وصحة التحقق منها، وتُقترح على القضايا الجديدة. المكتبة بيانات مرجعية عامة للإدارة ولا تحوي بيانات قضايا، عدا قائمة القضايا المرتبطة بالحكم المقيّدة بما يحق للمستخدم رؤيته.",
 "who_ar": [
  "مدير النظام",
  "مدير الشؤون القانونية",
  "رئيس القسم",
  "الموظف القانوني (إضافة وتعديل)",
  "مدخل البيانات وأمين الأرشيف والقراءة فقط (اطلاع وبحث)"
 ],
 "who_perms": [
  "LIBRARY_VIEW",
  "LIBRARY_MANAGE"
 ],
 "access_ar": "القائمة الجانبية > المكتبة (مكتبة الأحكام والسوابق القضائية). وداخل صفحة القضية قسم «الأحكام والسوابق» لربط حكم بالقضية.",
 "route": "/library",
 "prerequisites_ar": [
  "صلاحية LIBRARY_VIEW للاطلاع والبحث؛ وLIBRARY_MANAGE لإضافة حكم أو تعديله أو سحبه أو حفظ نسخته. الأدوار التي تملك الاثنين أصلًا: مدير النظام والمدير القانوني ورئيس القسم والموظف القانوني؛ أما مدخل البيانات وأمين الأرشيف والقراءة فقط فللاطلاع فقط.",
  "لربط حكم بقضية: LIBRARY_VIEW إضافة إلى حق تعديل تلك القضية (عضو فيها)، وألا تكون القضية مؤرشفة في الشاشة.",
  "تبدأ المكتبة فارغة ولا تضم إلا ما يضيفه الأعضاء."
 ],
