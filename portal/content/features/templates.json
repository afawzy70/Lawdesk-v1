{
  "id": "templates",
  "category": "cases",
  "name_ar": "النماذج القانونية الجاهزة ومسودات القضايا",
  "summary_ar": "مكتبة نماذج قانونية جاهزة (مذكرة دفاع، صحيفة دعوى، طلب تأجيل، كتاب طلب إفادة...) لها صيغ متتالية تمر بالمسودة ثم المراجعة ثم الاعتماد. ومن صفحة أي قضية يُنشأ «مسودة من نموذج» تُعبَّأ بياناتها الأساسية من ملف القضية، وما لا يحتويه ملف القضية يبقى حقلًا فارغًا مسمّى. المسودة غير نهائية دائمًا ولا تُحفظ.",
  "purpose_ar": "توفير نصوص موحّدة ومعتمدة تسرّع إعداد الأوراق القانونية وتقلل الأخطاء في نقل بيانات القضية، دون أن يخترع النظام أي بيان ناقص.",
  "who_ar": [
    "من يملك «إدارة النماذج القانونية»: ينشئ النماذج ويعدّل صيغها ويراجعها ويعتمدها",
    "من يملك «عرض القضايا» وله حق الاطلاع على القضية: يقرأ النماذج المعتمدة بلا نصوصها ويُعدّ منها مسودة للقضية"
  ],
  "who_perms": [
    "TEMPLATE_MANAGE",
    "CASE_VIEW"
  ],
  "access_ar": "القائمة > النماذج القانونية (للمديرين) ؛ وفي صفحة القضية > «مسودة من نموذج»",
  "route": "/templates",
  "prerequisites_ar": [
    "أنواع النماذج مأخوذة من القائمة المعيارية «أنواع النماذج»؛ ولا يُقبل نوع غير موجود أو معطّل.",
    "لا يُزرع أي نموذج مع النظام: تُنشأ النماذج بعد التشغيل.",
    "لإعداد مسودة: نموذج مستعمل وله صيغة معتمدة، وقضية ظاهرة للمستخدم."
  ],
