{
 "id": "reports-dashboard",
 "category": "insight",
 "name_ar": "لوحة المؤشرات والتقارير والتصدير",
 "summary_ar": "الصفحة الرئيسية تعرض أرقامًا محسوبة من سجلات النظام (القضايا والدعاوى والأحكام والجلسات والمهام) ومؤشرات رئيسية يمكن فتح كل رقم منها لرؤية السجلات التي يقوم عليها. وإلى جانبها تقارير: سجل القضايا والأحكام والجلسات وعبء العمل والخبراء وسبع عشرة عائلة تقارير، ويمكن تنزيلها بصيغ CSV وExcel وPDF بحد أقصى عشرة آلاف صف.",
 "purpose_ar": "تمكين الإدارة من رؤية الصورة العامة ومتابعة الأرقام دون عدّ يدوي، مع ضمان أن الرقم المعروض هو عدد السجلات التي تظهر عند فتحه نفسه وأن التنزيل يطابق الشاشة، وأن ما لا يمكن حسابه يُعلَن «غير متاح» بدل أن يظهر صفرًا مصطنعًا.",
 "who_ar": [
  "مدير النظام",
  "مدير الشؤون القانونية",
  "رئيس القسم",
  "القراءة فقط (للاطلاع دون تنزيل)"
 ],
 "who_perms": [
  "REPORT_VIEW",
  "REPORT_EXPORT"
 ],
 "access_ar": "الصفحة الرئيسية (لوحة المؤشرات)، وفي القائمة الجانبية «التقارير» لبقية التقارير.",
 "route": "/",
 "prerequisites_ar": [
  "REPORT_VIEW لعرض الأرقام والتقارير؛ REPORT_EXPORT للتنزيل. بحسب هجرات قاعدة البيانات يملك REPORT_VIEW وREPORT_EXPORT مدير النظام والمدير القانوني ورئيس القسم، ويملك دور القراءة فقط REPORT_VIEW دون التصدير. لم أتحقق من بقية الأدوار.",
  "المستخدم بلا REPORT_VIEW يرى الصفحة الرئيسية بلا أرقام مع عبارة «تظهر الإحصاءات للمستخدمين الذين لديهم صلاحية التقارير».",
  "المؤشرات تُحسب لقضايا المستخدم المرئية له فقط."
