{
 "id": "users-admin",
 "category": "access",
 "name_ar": "إدارة المستخدمين",
 "summary_ar": "يتيح لمسؤول المستخدمين البحث في الحسابات، وإنشاء حساب جديد بكلمة مرور مؤقتة وأدوار، وتعديل الاسم والبريد واللغة، وتعطيل الحساب أو تفعيله، وتغيير أدواره، وإعادة تعيين كلمة مروره، وتحديد وحدته في الإدارة القانونية.",
 "purpose_ar": "التحكم في من يدخل النظام وبأي دور، مع ضمانات تمنع التصعيد غير المقصود: لا يغيّر المستخدم أدواره أو حالته بنفسه، ولا يُمنح دورًا يدير المستخدمين أو الأدوار إلا من يملك إدارة الأدوار، ويبقى دائمًا مسؤول نظام مفعَّل واحد على الأقل.",
 "who_ar": [
  "من يملك «عرض المستخدمين» (USER_VIEW) للاطلاع",
  "من يملك «إدارة المستخدمين» (USER_MANAGE) للإنشاء والتعديل",
  "من يملك «إدارة الهيكل التنظيمي» (ORG_MANAGE) لتحديد وحدة المستخدم"
 ],
 "who_perms": [
  "USER_VIEW",
  "USER_MANAGE",
  "ORG_MANAGE",
  "ROLE_MANAGE"
 ],
 "access_ar": "الإدارة > المستخدمون؛ ثم «مستخدم جديد» أو الضغط على اسم مستخدم في القائمة.",
 "route": "/admin ، /admin/users/new ، /admin/users/:id",
 "prerequisites_ar": [
  "جلسة دخول صالحة وصلاحية USER_VIEW (للقائمة) أو USER_MANAGE (للتعديل).",
  "وجود الأدوار المراد إسنادها (انظر «الأدوار وكتالوج الصلاحيات»)."
 ],
