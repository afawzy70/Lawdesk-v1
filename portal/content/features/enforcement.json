{
 "id": "enforcement",
 "category": "legal",
 "name_ar": "تنفيذ الأحكام",
 "summary_ar": "يتيح فتح «ملف تنفيذ» لكل حكم صادر في قضية، وتسجيل حالة التنفيذ والعضو المسؤول والجهة المنفِّذة والمبلغ المطلوب والعقبات والتاريخ المستهدف، ثم تسجيل الإجراءات والمراسلات المتتابعة مع نتائجها. وتوجد قائمة مستقلة بالأحكام غير المنفَّذة أو المتأخرة في القضايا التي يحق للمستخدم الاطلاع عليها.",
 "purpose_ar": "ألا يضيع حكم صادر دون متابعة تنفيذه: يعرف الموظف ما تم وما تعثّر ومن المسؤول، وتعرف الإدارة الأحكام التي لم تُنفَّذ بعد أو تجاوزت التاريخ الذي حدّده العضو لنفسه. التاريخ المستهدف يدخله الموظف بنفسه ولا يحسب النظام أي مدة قانونية.",
 "who_ar": [
  "مدير الشؤون القانونية",
  "رئيس القسم",
  "الموظف القانوني (للاطلاع والإدارة)",
  "مدخل البيانات والاطلاع فقط (للاطلاع)",
  "مدير النظام"
 ],
 "who_perms": [
  "ENFORCEMENT_VIEW",
  "ENFORCEMENT_MANAGE"
 ],
 "access_ar": "القائمة الجانبية > تنفيذ الأحكام (قائمة الأحكام غير المنفَّذة). وملف حكم بعينه يظهر داخل صفحة القضية، في قسم المراحل والأحكام، تحت الحكم نفسه: «تنفيذ الحكم».",
 "route": "/enforcement",
 "prerequisites_ar": [
  "وجود حكم مسجَّل في إحدى مراحل القضية (سجل الأحكام يخص ميزة المراحل والأحكام).",
  "أن يملك المستخدم صلاحية ENFORCEMENT_VIEW للاطلاع وENFORCEMENT_MANAGE للتسجيل والتعديل، وأن يحق له الاطلاع على القضية؛ وللتسجيل والتعديل أن يحق له تعديل القضية (عضو فيها).",
  "ألا تكون القضية مؤرشفة (القضية المؤرشفة للقراءة فقط)."
 ],
