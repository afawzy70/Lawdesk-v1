  "id": "case-links",
  "category": "cases",
  "name_ar": "ربط القضايا ببعضها (القضايا المرتبطة)",
  "summary_ar": "يمكن ربط قضية بقضية أخرى بارتباط موضوعي، أو بطلب ضم، أو بقرار ضم، أو بإحالة، مع ذكر السبب ومن طلب الارتباط وتاريخه وقرار المحكمة إن صدر. يظهر الارتباط الواحد في ملف القضيتين معًا، ولا يؤثر إغلاق إحداهما في الأخرى.",
  "purpose_ar": "إبقاء العلاقة بين القضايا المتصلة ظاهرة للعضو الذي يتابع أيًّا منهما، وتتبع طلبات الضم وقرارات المحكمة فيها، دون أن يكشف الارتباط قضية لا يحق للمستخدم رؤيتها.",
  "who_ar": [
    "من يملك «عرض القضايا» لرؤية الارتباطات",
    "من يملك «ربط القضايا» ويحق له تغيير القضية لإضافة ارتباط أو تغيير حالته"
  ],
  "who_perms": [
    "CASE_VIEW",
    "CASE_LINK_MANAGE"
  ],
  "access_ar": "القائمة > القضايا > فتح قضية > قسم «القضايا المرتبطة»",
  "route": "/cases/:id",
  "prerequisites_ar": [
    "أن تكون القضية ظاهرة للمستخدم.",
    "للإضافة: صلاحية CASE_LINK_MANAGE وأن يحق للمستخدم تغيير القضية وأن تكون غير مؤرشفة (وإلا لا تظهر نماذج الإضافة).",
    "وجود القضية الأخرى وأن تكون ظاهرة للمستخدم."
