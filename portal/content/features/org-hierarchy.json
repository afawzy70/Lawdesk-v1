{
 "id": "org-hierarchy",
 "category": "access",
 "name_ar": "الهيكل التنظيمي",
 "summary_ar": "شجرتان من الوحدات: «الإدارة القانونية» (وحدات الإدارة نفسها التي يعمل فيها المستخدمون) و«قطاعات الهيئة وإداراتها» (الجهات التي تتعلق بها القضايا). تتدرج الوحدة من قطاع إلى إدارة إلى قسم. لا تُحذف الوحدة بل تُعطَّل، ويمكن وضع كل مستخدم في وحدة من الشجرة القانونية.",
 "purpose_ar": "يخدم الهيكل غرضين: تحديد نطاق اطلاع رؤساء الأقسام والمدير على القضايا بحسب الوحدة، وتسجيل الجهة المعنية بكل قضية. التعطيل بدل الحذف يُبقي إشارة القضايا القديمة إلى الوحدة سليمة بعد تغيير الهيكل.",
 "who_ar": [
  "من يملك «إدارة الهيكل التنظيمي» (ORG_MANAGE) للإنشاء والتعديل ووضع المستخدمين",
  "من يملك ORG_MANAGE أو «عرض القضايا» (CASE_VIEW) أو «إنشاء القضايا» (CASE_CREATE) لقراءة الوحدات"
 ],
 "who_perms": [
  "ORG_MANAGE",
  "CASE_VIEW",
  "CASE_CREATE"
 ],
 "access_ar": "الإدارة > الهيكل التنظيمي؛ وتحديد وحدة المستخدم من صفحة المستخدم (قسم «الوحدة في الإدارة القانونية»).",
 "route": "/admin/org",
 "prerequisites_ar": [
  "جلسة دخول صالحة وصلاحية ORG_MANAGE لظهور تبويبة «الهيكل التنظيمي».",
  "لا يُنشأ هيكل افتراضي: الشجرة تبدأ فارغة ولا تختلق النظام أي وحدات."
 ],
